<UserControl x:Class="FluxorWpfApp.Views.MyLabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="MyLab Fluxor State Manager" 
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Session Section -->
        <GroupBox Grid.Row="1" Header="Session Management" Margin="0,0,0,15">
            <StackPanel Margin="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Patient Name:" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PatientName, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="5" Padding="5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Patient ID:" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PatientId, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="5" Padding="5"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Session Status:" VerticalAlignment="Center" Margin="0,5"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{Binding SessionStatusText}" FontWeight="Bold" 
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="Start Session" Command="{Binding StartSessionCommand}" 
                                Width="100" Padding="5" Margin="5,0"/>
                        <Button Content="End Session" Command="{Binding EndSessionCommand}" 
                                Width="100" Padding="5" Margin="5,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- Scan Control Section -->
        <GroupBox Grid.Row="2" Header="Scan Control" Margin="0,0,0,15">
            <StackPanel Margin="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Scan Status:" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{Binding ScanStatusText}" FontWeight="Bold" 
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="Start Scan" Command="{Binding StartScanCommand}" 
                                Width="100" Padding="5" Margin="5,0"/>
                        <Button Content="Freeze" Command="{Binding FreezeScanCommand}" 
                                Width="100" Padding="5" Margin="5,0"/>
                        <Button Content="Stop" Command="{Binding StopScanCommand}" 
                                Width="100" Padding="5" Margin="5,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- BMode Controls Section -->
        <GroupBox Grid.Row="3" Header="B-Mode Settings" Margin="0,0,0,15">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Gain Control -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Gain:" VerticalAlignment="Center" Margin="5"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <Slider x:Name="GainSlider" Minimum="0" Maximum="100" Width="200" 
                            Value="{Binding GainValue, Mode=TwoWay}" 
                            VerticalAlignment="Center" Margin="5"/>
                    <TextBlock Text="{Binding GainValue}" Width="40" VerticalAlignment="Center" 
                               Margin="10,0,0,0" FontWeight="Bold"/>
                </StackPanel>

                <!-- Depth Control -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Depth:" VerticalAlignment="Center" Margin="5"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <Slider x:Name="DepthSlider" Minimum="0" Maximum="200" Width="200" 
                            Value="{Binding DepthValue, Mode=TwoWay}" 
                            VerticalAlignment="Center" Margin="5"/>
                    <TextBlock Text="{Binding DepthValue}" Width="40" VerticalAlignment="Center" 
                               Margin="10,0,0,0" FontWeight="Bold"/>
                </StackPanel>

                <!-- Frequency Control -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Frequency:" VerticalAlignment="Center" Margin="5"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <Slider x:Name="FrequencySlider" Minimum="1" Maximum="15" Width="200" 
                            Value="{Binding FrequencyValue, Mode=TwoWay}" 
                            VerticalAlignment="Center" Margin="5"/>
                    <TextBlock Text="{Binding FrequencyValue}" Width="40" VerticalAlignment="Center" 
                               Margin="10,0,0,0" FontWeight="Bold"/>
                    <TextBlock Text="MHz" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>

                <!-- Focus Control -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Focus:" VerticalAlignment="Center" Margin="5"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                    <Slider x:Name="FocusSlider" Minimum="0" Maximum="100" Width="200" 
                            Value="{Binding FocusValue, Mode=TwoWay}" 
                            VerticalAlignment="Center" Margin="5"/>
                    <TextBlock Text="{Binding FocusValue}" Width="40" VerticalAlignment="Center" 
                               Margin="10,0,0,0" FontWeight="Bold"/>
                </StackPanel>

                <!-- Dynamic Range Control -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Dynamic Range:" VerticalAlignment="Center" Margin="5"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                    <Slider x:Name="DynamicRangeSlider" Minimum="0" Maximum="100" Width="200" 
                            Value="{Binding DynamicRangeValue, Mode=TwoWay}" 
                            VerticalAlignment="Center" Margin="5"/>
                    <TextBlock Text="{Binding DynamicRangeValue}" Width="40" VerticalAlignment="Center" 
                               Margin="10,0,0,0" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- State Display Section -->
        <GroupBox Grid.Row="4" Header="Current State (Debug)">
            <ScrollViewer>
                <TextBlock Text="{Binding StateDebugInfo}" FontFamily="Consolas" 
                           FontSize="11" Margin="10" TextWrapping="Wrap"/>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</UserControl>
