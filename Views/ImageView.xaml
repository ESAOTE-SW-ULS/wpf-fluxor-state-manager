<UserControl x:Class="FluxorWpfApp.Views.ImageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <Style x:Key="ControlGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>
        
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#E74C3C"/>
        </Style>
        
        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                               CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2980B9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#21618C"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#95A5A6"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" 
                   Text="Image Controls" 
                   FontSize="28" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center"
                   Margin="0,0,0,30"/>
        
        <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center">
            
            <!-- Gain Control -->
            <Border Style="{StaticResource ControlGroupStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="Gain:" Style="{StaticResource LabelStyle}"/>
                    
                    <Button x:Name="GainDecrementButton" 
                            Grid.Column="1" 
                            Content="-" 
                            Click="GainDecrementButton_Click"
                            Style="{StaticResource ControlButtonStyle}"/>
                    
                    <TextBlock x:Name="GainValue" 
                              Grid.Column="2" 
                              Text="50" 
                              Style="{StaticResource ValueStyle}"/>
                    
                    <Button x:Name="GainIncrementButton" 
                            Grid.Column="3" 
                            Content="+" 
                            Click="GainIncrementButton_Click"
                            Style="{StaticResource ControlButtonStyle}"/>
                </Grid>
            </Border>
            
            <!-- Width Control -->
            <Border Style="{StaticResource ControlGroupStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="Width:" Style="{StaticResource LabelStyle}"/>
                    
                    <Button x:Name="WidthDecrementButton" 
                            Grid.Column="1" 
                            Content="-" 
                            Click="WidthDecrementButton_Click"
                            Style="{StaticResource ControlButtonStyle}"/>
                    
                    <TextBlock x:Name="WidthValue" 
                              Grid.Column="2" 
                              Text="50" 
                              Style="{StaticResource ValueStyle}"/>
                    
                    <Button x:Name="WidthIncrementButton" 
                            Grid.Column="3" 
                            Content="+" 
                            Click="WidthIncrementButton_Click"
                            Style="{StaticResource ControlButtonStyle}"/>
                </Grid>
            </Border>
            
            <!-- Zoom Control -->
            <Border Style="{StaticResource ControlGroupStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="Zoom:" Style="{StaticResource LabelStyle}"/>
                    
                    <Button x:Name="ZoomDecrementButton" 
                            Grid.Column="1" 
                            Content="-" 
                            Click="ZoomDecrementButton_Click"
                            Style="{StaticResource ControlButtonStyle}"/>
                    
                    <TextBlock x:Name="ZoomValue" 
                              Grid.Column="2" 
                              Text="50" 
                              Style="{StaticResource ValueStyle}"/>
                    
                    <Button x:Name="ZoomIncrementButton" 
                            Grid.Column="3" 
                            Content="+" 
                            Click="ZoomIncrementButton_Click"
                            Style="{StaticResource ControlButtonStyle}"/>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>